# MutCert — environment variables
# Copy this file to .env and adjust values as needed.
# The defaults below match the docker-compose setup out of the box.

# Neo4j connection (used by both the app and docker-compose NEO4J_AUTH)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=mutcert
